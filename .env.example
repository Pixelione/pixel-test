# Copia in .env.local e compila. .env.local non va mai su GitHub.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Solo per applicare le migrazioni da riga di comando
DATABASE_URL=postgresql://...
# Stripe: chiavi TEST (sk_test_...). Le live solo dopo il commercialista.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Commissione aggiunta al totale (carte UE standard Stripe Italia)
STRIPE_FEE_PERCENT=1.5
STRIPE_FEE_FIXED_CENTS=25
# Email (separate da virgola) che vedono /admin
ADMIN_EMAILS=tu@esempio.it
# Facoltativo: lista d'attesa pre-lancio, per il pixel omaggio agli iscritti confermati
PRELAUNCH_SUPABASE_URL=
PRELAUNCH_SUPABASE_SECRET_KEY=
